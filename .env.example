# Neon: マイグレーション用（direct 接続）
DATABASE_URL=

# Neon: ai-service 用（pooled 接続）。未設定なら DATABASE_URL にフォールバックする
DATABASE_URL_POOLED=

# Qiita API v2 の個人用アクセストークン（未設定なら 60 req/h、設定すると 1000 req/h）
QIITA_TOKEN=

# OpenAI Embeddings API
OPENAI_API_KEY=

# ai-service の共有APIキー（Next.js の API Route → Lambda の認証に使う）
AI_SERVICE_API_KEY=
